{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fracst-gateway",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"durable_objects": {
		"bindings": [
			// One per connection: relays it to the GPU server.
			{ "name": "SESSIONS", "class_name": "Session" },
			// A single one: keys, usage and open sessions.
			{ "name": "REGISTRY", "class_name": "Registry" }
		]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session", "Registry"] }],
	"vars": {
		// The fracst-server to relay to: on Modal "wss://<workspace>--fracst.modal.run",
		// or for testing "ws://127.0.0.1:7878".
		"UPSTREAM_URL": "",
		// Or a fal app, as "<fal user>/<app name>", e.g. "alex/fracst".
		"FAL_APP": "",
		// A session is closed after this long; the app can reconnect.
		"MAX_SESSION_MINUTES": "120",
		// Sessions one key may have open at once.
		"MAX_SESSIONS_PER_KEY": "2"
	},
	// Secrets (wrangler secret put NAME): MODAL_KEY and MODAL_SECRET, a Modal
	// proxy auth token, or FAL_KEY, a fal.ai key; ADMIN_TOKEN, for the
	// /admin endpoints.
	"observability": { "enabled": true }
}
